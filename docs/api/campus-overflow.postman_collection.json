{
  "info": {
    "name": "CampusOverflow API",
    "description": "CampusOverflow 课程贯穿项目接口集合。\n\n使用说明：\n1. 先在环境变量中设置 baseUrl（默认 http://localhost:8080）。\n2. 调用任何非 GET 接口前，先请求 GET /api/v1/auth/csrf，把响应写入的 XSRF-TOKEN Cookie 值复制到请求头 X-XSRF-TOKEN。\n3. 会话通过 HttpOnly Cookie 保持，Postman 需开启 Cookie 持久化。\n4. 路径变量 questionId/answerId/userId/courseId/notificationId 在集合变量中回填。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "questionId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "answerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "认证 Auth",
      "item": [
        {
          "name": "获取 CSRF Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "非 GET 请求前先调用；响应同时写入 XSRF-TOKEN Cookie，需把其值放到后续请求头 X-XSRF-TOKEN。"
          },
          "response": []
        },
        {
          "name": "学生注册",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student01\",\n  \"displayName\": \"张宇航\",\n  \"email\": \"student01@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"college\": \"计算机工程学院\",\n  \"className\": \"计科2411\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "登录",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student01\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "当前登录用户",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "登出",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "问答 Q&A",
      "item": [
        {
          "name": "问题列表",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "courseId",
                  "value": "{{courseId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "发布问题（Lab4 成功用例）",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "端到端贯通用例：成功后返回 {\"id\": 问题ID}，可回填到 {{questionId}}。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": 1,\n  \"title\": \"补码和原码怎么互相转换？\",\n  \"body\": \"求详细步骤与一个具体例子。\",\n  \"tags\": [\n    \"计算机组成原理\",\n    \"补码\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "问题详情",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "编辑问题",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"补码和原码怎么互相转换？（修订）\",\n  \"body\": \"补充例子。\",\n  \"tags\": [\n    \"补码\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "删除问题",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "提交回答",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/answers",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"先求反码，再在末位加 1。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "编辑回答",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/answers/{{answerId}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"补充：符号位保持不变。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "删除回答",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/answers/{{answerId}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "采纳回答",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/accepted-answer",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answerId\": \"{{answerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "回答背书（专家认可）",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/answers/{{answerId}}/endorsement",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        }
      ]
    },
    {
      "name": "互动 Interaction",
      "item": [
        {
          "name": "投票",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/votes",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "targetType: QUESTION/ANSWER；value: 1 赞同 / -1 反对。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"QUESTION\",\n  \"targetId\": \"{{questionId}}\",\n  \"value\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "发表评论",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/comments",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"QUESTION\",\n  \"targetId\": \"{{questionId}}\",\n  \"body\": \"补充一个例子\",\n  \"parentId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "热门标签",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tags/popular",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "15"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "发现 Discovery",
      "item": [
        {
          "name": "中文搜索",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/search/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Java 集合"
                },
                {
                  "key": "tag",
                  "value": ""
                },
                {
                  "key": "sort",
                  "value": "newest"
                },
                {
                  "key": "unanswered",
                  "value": "false"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "相关问题推荐",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/related",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "声誉 Reputation",
      "item": [
        {
          "name": "排行榜",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/leaderboard",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "week"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "用户声誉概览",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/reputation",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "声誉流水",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/reputation/ledger",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "设置悬赏",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/bounty",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": 50,\n  \"days\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        },
        {
          "name": "查看悬赏",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/bounty",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "通知 Notification",
      "item": [
        {
          "name": "通知列表",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "未读数",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/unread-count",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "标记单条已读",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "全部标记已读",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/read-all",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        }
      ]
    },
    {
      "name": "课程 Course",
      "item": [
        {
          "name": "课程列表",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "我加入的课程",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/mine",
              "host": [
                "{{baseUrl}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}